{
  "name": "game-auto-script",
  "version": "0.1.0",
  "private": true,
  "description": "《无尽冬日》日常任务自动化 —— MaaFramework + MuMu 模拟器（自研 Node 应用）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "doctor": "node src/index.mjs doctor",
    "run": "node src/index.mjs run",
    "list": "node src/index.mjs list",
    "capture": "node src/index.mjs capture",
    "preui": "node tools/webui-build.mjs",
    "ui": "node src/index.mjs ui",
    "webui:build": "node tools/webui-build.mjs --force",
    "webui:dev": "node tools/webui-dev.mjs",
    "webui:smoke": "node tools/webui-smoke.mjs",
    "record": "node src/index.mjs record",
    "replay": "node src/index.mjs replay",
    "selftest:replay": "node tools/selftest-replay.mjs --replay-only",
    "fetch-assets": "node tools/fetch-assets.mjs",
    "test": "node test/run.mjs"
  },
  "dependencies": {
    "@maaxyz/maa-node": "5.13.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "vite": "^8.3.0",
    "vue": "^3.5.43"
  }
}
