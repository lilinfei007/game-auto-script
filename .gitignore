# 依赖与安装缓存
node_modules/
.npm-cache/

# 运行时产物
debug/
*.log

# 打包产物（由 tools/build-portable.mjs 生成，不上传）
dist/

# 下载的第三方素材（由 tools/fetch-assets.mjs 复现）
resource/model/ocr/
docs/reference/

# 个人任务集（界面里编排出来的「我要跑什么」，跟玩法绑定，不随仓库分发）
config/tasks.json

# 截图原始素材（由 tools/capture.mjs 生成，仅保留裁剪后的模板）
resource/image/_raw/
